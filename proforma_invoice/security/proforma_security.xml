<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ============================================================
             Security Groups
        ============================================================ -->
        <record id="group_sale_proforma_approver" model="res.groups">
            <field name="name">Proforma Invoice Approver</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>

    <data noupdate="1">

        <!-- ============================================================
             IR Sequence for Proforma Invoice numbering
        ============================================================ -->
        <record id="seq_sale_order_proforma" model="ir.sequence">
            <field name="name">Proforma Invoice</field>
            <field name="code">sale.order.proforma</field>
            <field name="prefix">PI/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
