<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ai_gl_config_comp_rule" model="ir.rule">
            <field name="name">AI GL Config Multi-Company Rule</field>
            <field name="model_id" ref="model_ai_gl_config"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="ai_gl_config_expense_line_comp_rule" model="ir.rule">
            <field name="name">AI GL Config Expense Line Multi-Company Rule</field>
            <field name="model_id" ref="model_ai_gl_config_expense_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
