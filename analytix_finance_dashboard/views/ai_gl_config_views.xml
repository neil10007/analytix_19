<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree / List View for AI GL Configuration -->
    <record id="view_ai_gl_config_tree" model="ir.ui.view">
        <field name="name">ai.gl.config.list</field>
        <field name="model">ai.gl.config</field>
        <field name="arch" type="xml">
            <list string="AI GL Configurations">
                <field name="name"/>
                <field name="type"/>
                <field name="company_id"/>
                <field name="income_account_id" optional="show"/>
                <field name="sale_tax_id" optional="show"/>
                <field name="sale_tax_account_id" optional="show"/>
                <field name="expense_account_id" optional="show"/>
                <field name="purchase_tax_id" optional="show"/>
                <field name="tax_account_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Form View for AI GL Configuration -->
    <record id="view_ai_gl_config_form" model="ir.ui.view">
        <field name="name">ai.gl.config.form</field>
        <field name="model">ai.gl.config</field>
        <field name="arch" type="xml">
            <form string="AI GL Configuration">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Configuration Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="type" widget="radio" options="{'horizontal': false}"/>
                        </group>
                        <group>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                    </group>

                    <!-- Section 1: Sales Invoice -->
                    <group string="Sales Invoice Configuration" invisible="type != 'sales_invoice'">
                        <group>
                            <field name="income_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['income', 'income_other']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'sales_invoice'"/>
                            <field name="sale_tax_id"
                                   options="{'no_create': True}"
                                   domain="[('type_tax_use', '=', 'sale'), ('company_id', 'in', [company_id, False])]"
                                   invisible="type != 'sales_invoice'"/>
                            <field name="sale_tax_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['asset_current', 'liability_current', 'expense', 'expense_direct_cost']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'sales_invoice'"/>
                        </group>
                    </group>

                    <!-- Section 2: Purchase Bills -->
                    <group string="Purchase Bills Configuration" invisible="type != 'purchase_bill'">
                        <group>
                            <field name="expense_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['expense', 'expense_depreciation', 'expense_direct_cost', 'cost_of_goods_sold']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'purchase_bill'"/>
                            <field name="purchase_tax_id"
                                   options="{'no_create': True}"
                                   domain="[('type_tax_use', '=', 'purchase'), ('company_id', 'in', [company_id, False])]"
                                   invisible="type != 'purchase_bill'"/>
                            <field name="tax_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['asset_current', 'liability_current', 'expense', 'expense_direct_cost']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'purchase_bill'"/>
                        </group>
                    </group>

                    <!-- Section 3: Expense Bills -->
                    <group string="Expense Bills Configuration" invisible="type != 'expense_bill'">
                        <group>
                            <field name="expense_bill_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['expense', 'expense_depreciation', 'expense_direct_cost', 'cost_of_goods_sold']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'expense_bill'"/>
                            <field name="expense_bill_tax_id"
                                   options="{'no_create': True}"
                                   domain="[('type_tax_use', '=', 'purchase'), ('company_id', 'in', [company_id, False])]"
                                   invisible="type != 'expense_bill'"/>
                            <field name="expense_bill_tax_account_id"
                                   options="{'no_create': True}"
                                   domain="[('account_type', 'in', ['asset_current', 'liability_current', 'expense', 'expense_direct_cost']), ('company_ids', 'in', company_id)]"
                                   invisible="type != 'expense_bill'"/>
                        </group>
                    </group>

                    <notebook invisible="type != 'expense_bill'">
                        <page string="Expense Category Mapping Lines">
                            <field name="expense_line_ids">
                                <list editable="bottom">
                                    <field name="expense_bills_type"/>
                                    <field name="keywords" placeholder="e.g. flight, ticket, airline"/>
                                    <field name="expense_account_id" options="{'no_create': True}" domain="[('account_type', 'in', ['expense', 'expense_depreciation', 'expense_direct_cost', 'cost_of_goods_sold', 'asset_fixed', 'asset_current']), ('company_ids', 'in', parent.company_id)]"/>
                                    <field name="tax_id" options="{'no_create': True}" domain="[('type_tax_use', '=', 'purchase'), ('company_id', 'in', [parent.company_id, False])]"/>
                                    <field name="tax_account_id" options="{'no_create': True}" domain="[('account_type', 'in', ['asset_current', 'liability_current', 'expense', 'expense_direct_cost']), ('company_ids', 'in', parent.company_id)]"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View for AI GL Configuration -->
    <record id="view_ai_gl_config_search" model="ir.ui.view">
        <field name="name">ai.gl.config.search</field>
        <field name="model">ai.gl.config</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type"/>
                <field name="company_id"/>
                <filter string="Sales Invoices" name="filter_sales_invoice" domain="[('type', '=', 'sales_invoice')]"/>
                <filter string="Purchase Bills" name="filter_purchase_bill" domain="[('type', '=', 'purchase_bill')]"/>
                <filter string="Expense Bills" name="filter_expense_bill" domain="[('type', '=', 'expense_bill')]"/>
                <filter string="Document Type" name="group_type" context="{'group_by': 'type'}"/>
                <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action for AI GL Configuration -->
    <record id="action_ai_gl_config" model="ir.actions.act_window">
        <field name="name">AI GL Configuration</field>
        <field name="res_model">ai.gl.config</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_gl_config_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new AI GL Configuration
            </p>
            <p>
                Configure default income/expense chart of accounts and taxes for Sales Invoices, Purchase Bills, and Expense Bills.
            </p>
        </field>
    </record>

    <!-- Menu Item under Configuration (account.menu_finance_configuration) -->
    <menuitem id="menu_ai_gl_configuration"
              name="AI GL Configuration"
              action="action_ai_gl_config"
              parent="account.menu_finance_configuration"
              sequence="25"/>
</odoo>
