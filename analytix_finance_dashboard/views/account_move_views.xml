<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_partner_editable_details" model="ir.ui.view">
        <field name="name">account.move.form.inherit.partner.editable.details</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Replace default static read-only address snippet with editable address & tax fields -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="context">{
                    'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                    'show_address': 0,
                    'show_vat': False,
                    'default_is_company': True
                }</attribute>
                <attribute name="widget">many2one</attribute>
                <attribute name="readonly">state == 'posted'</attribute>
            </xpath>

            <!-- Render editable partner address and tax details under partner_id -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <div class="o_address_format mt-1" invisible="not partner_id or move_type not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund', 'in_receipt')">
                    <field name="partner_street" placeholder="Street..." class="o_address_street" readonly="state == 'posted'"/>
                    <field name="partner_street2" placeholder="Street 2..." class="o_address_street" readonly="state == 'posted'"/>
                    <field name="partner_city" placeholder="City" class="o_address_city" readonly="state == 'posted'"/>
                    <field name="partner_state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_create': True}" readonly="state == 'posted'"/>
                    <field name="partner_zip" placeholder="ZIP" class="o_address_zip" readonly="state == 'posted'"/>
                    <field name="partner_country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}" readonly="state == 'posted'"/>
                    <field name="partner_vat" placeholder="Tax ID / VAT" class="w-100 mt-1" readonly="state == 'posted'"/>
                </div>
            </xpath>

            <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                <attribute name="readonly">state == 'posted'</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="readonly">state == 'posted'</attribute>
            </xpath>
        </field>
    </record>
</odoo>
