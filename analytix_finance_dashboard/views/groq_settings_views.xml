<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit res.users tree/list view -->
        <record id="view_users_tree_inherit_groq" model="ir.ui.view">
            <field name="name">res.users.tree.inherit.groq</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position="after">
                    <field name="groq_api_key" password="True" string="Groq API Key"/>
                    <field name="open_router_key" password="True" string="OpenRouter API Key"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit res.users form view -->
        <record id="view_users_form_inherit_groq" model="ir.ui.view">
            <field name="name">res.users.form.inherit.groq</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Position INSIDE the Access Rights tab (at the bottom, after the groups widget).
                     groups="base.group_no_one" = only visible when Developer Mode is active.
                     The field is additionally restricted to group_groq_super_admin (uid=2 only). -->
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <group string="AI API Configuration" groups="base.group_no_one">
                        <group groups="analytix_finance_dashboard.group_groq_super_admin">
                            <field name="groq_api_key" password="True" placeholder="Enter Groq API Key..."/>
                            <field name="open_router_key" password="True" placeholder="Enter OpenRouter API Key..."/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Inherit res.company tree/list view -->
        <record id="view_company_tree_inherit_groq" model="ir.ui.view">
            <field name="name">res.company.tree.inherit.groq</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="groq_api_key" password="True" string="Groq API Key"/>
                    <field name="open_router_key" password="True" string="OpenRouter API Key"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit res.company form view -->
        <record id="view_company_form_inherit_groq" model="ir.ui.view">
            <field name="name">res.company.form.inherit.groq</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="AI Configuration" name="groq_ai_config">
                        <group>
                            <field name="groq_api_key" password="True" placeholder="Enter Groq API Key..."/>
                            <field name="open_router_key" password="True" placeholder="Enter OpenRouter API Key..."/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Submenu under Users & Companies settings menu -->
        <record id="action_res_users_groq" model="ir.actions.act_window">
            <field name="name">Groq API Keys</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="base.view_users_tree"/>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Configure Groq API Keys for Users
              </p>
              <p>
                Add a Groq API Key to each user to enable AI-powered document processing from the dashboard.
              </p>
            </field>
        </record>

        <menuitem id="menu_res_users_groq"
                  name="Groq API Keys"
                  parent="base.menu_users"
                  action="action_res_users_groq"
                  groups="analytix_finance_dashboard.group_groq_super_admin"
                  sequence="30"/>
    </data>
</odoo>
