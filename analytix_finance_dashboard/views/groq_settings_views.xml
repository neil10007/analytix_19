<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Inherit res.users tree/list view: Restrict AI fields to Super Admin only, hidden by default -->
        <record id="view_users_tree_inherit_groq" model="ir.ui.view">
            <field name="name">res.users.tree.inherit.groq</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='login']" position="after">
                    <field name="open_router_key" password="True" string="OpenRouter API Key" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                    <field name="openrouter_model" string="OpenRouter Model" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                    <field name="groq_api_key" password="True" string="Groq API Key" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                    <field name="chatting_model" string="Chatting Model" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                </xpath>
            </field>
        </record>

        <!-- Dedicated List View for AI API Configuration (Super Admin menu) -->
        <record id="view_users_tree_groq_config" model="ir.ui.view">
            <field name="name">res.users.tree.groq.config</field>
            <field name="model">res.users</field>
            <field name="arch" type="xml">
                <list string="AI API Configuration" create="0" delete="0">
                    <field name="name"/>
                    <field name="login"/>
                    <field name="open_router_key" password="True"/>
                    <field name="openrouter_model"/>
                    <field name="chatting_model" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Inherit res.users form view: Visible ONLY when viewing the Super Admin account (is_super_admin_user)
             Restricted to group_groq_super_admin. Developer Mode is NOT required. -->
        <record id="view_users_form_inherit_groq" model="ir.ui.view">
            <field name="name">res.users.form.inherit.groq</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <field name="is_super_admin_user" invisible="1"/>
                    <group string="OpenRouter AI Configuration (Master / All Users)"
                           groups="analytix_finance_dashboard.group_groq_super_admin"
                           invisible="not is_super_admin_user">
                        <div class="text-muted mb-2">
                            Master OpenRouter credentials configured on this Super Admin account are automatically used by all users across the system for AI OCR document processing.
                        </div>
                        <group>
                            <field name="open_router_key" password="True" placeholder="Enter OpenRouter API Key (sk-or-v1-...)..."/>
                            <field name="openrouter_model" string="OpenRouter Model Selection"/>
                            <field name="groq_api_key" password="True" placeholder="Enter Groq API Key (Optional)..."/>
                            <field name="chatting_model" placeholder="e.g. google/gemini-2.5-flash"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Inherit res.company tree/list view: Restrict to Super Admin -->
        <record id="view_company_tree_inherit_groq" model="ir.ui.view">
            <field name="name">res.company.tree.inherit.groq</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="open_router_key" password="True" string="OpenRouter API Key" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                    <field name="openrouter_model" string="OpenRouter Model" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                    <field name="groq_api_key" password="True" string="Groq API Key" optional="hide" groups="analytix_finance_dashboard.group_groq_super_admin"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit res.company form view: Restricted to Super Admin -->
        <record id="view_company_form_inherit_groq" model="ir.ui.view">
            <field name="name">res.company.form.inherit.groq</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="AI Configuration" name="groq_ai_config" groups="analytix_finance_dashboard.group_groq_super_admin">
                        <group>
                            <field name="open_router_key" password="True" placeholder="Enter OpenRouter API Key..."/>
                            <field name="openrouter_model" string="OpenRouter Model Selection"/>
                            <field name="groq_api_key" password="True" placeholder="Enter Groq API Key..."/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Submenu under Users & Companies settings menu: Filters ONLY to Super Admin user -->
        <record id="action_res_users_groq" model="ir.actions.act_window">
            <field name="name">OpenRouter AI Configuration</field>
            <field name="res_model">res.users</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_users_tree_groq_config')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_users_form')})]"/>
            <field name="domain">['|', ('id', '=', 2), ('group_ids', 'in', [ref('analytix_finance_dashboard.group_groq_super_admin')])]</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Super Admin OpenRouter AI Configuration
              </p>
              <p>
                Configure the master OpenRouter API Key and Model for the Super Administrator.
                Once configured here, all authorized users can seamlessly use the AI Create button from the dashboard.
              </p>
            </field>
        </record>

        <menuitem id="menu_res_users_groq"
                  name="AI API Configuration"
                  parent="base.menu_users"
                  action="action_res_users_groq"
                  groups="analytix_finance_dashboard.group_groq_super_admin"
                  sequence="30"/>
    </data>
</odoo>
