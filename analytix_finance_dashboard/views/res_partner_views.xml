<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_mother_lang" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.mother.lang</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mother_lang" placeholder="Name"/>
            </xpath>
        </field>
    </record>
</odoo>
