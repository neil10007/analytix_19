<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Template Base Form View to add Product Arabic Name cleanly below Product Name -->
    <record id="product_template_form_view_inherit_arabic" model="ir.ui.view">
        <field name="name">product.template.form.inherit.arabic</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//h1" position="after">
                <div class="w-100 mt-1 mb-2">
                    <label for="product_arabic_name" string="Product Arabic Name" class="fw-bold text-muted small" style="font-size: 0.85rem;"/>
                    <div class="h3 mb-0" style="font-size: 1.25rem; font-weight: 600; color: #1E293B;">
                        <field name="product_arabic_name" placeholder="اسم المنتج بالعربي..." style="direction: rtl; text-align: left; font-weight: 600;"/>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
