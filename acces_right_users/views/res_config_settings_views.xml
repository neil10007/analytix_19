<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Extend General Settings – hide Developer Tools for non-super-admins
         ================================================================ -->

    <record id="res_config_settings_view_form_inherit_dev_xpath" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.access.rights.dev.xpath</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
                In Odoo 19, developer tools are rendered via the widget 'res_config_dev_tool'.
                We restrict it to only be visible to Super Admin group members.
            -->
            <xpath expr="//widget[@name='res_config_dev_tool']" position="attributes">
                <attribute name="groups">acces_right_users.group_super_admin</attribute>
            </xpath>
        </field>
    </record>

</odoo>
