<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="new_login_layout" inherit_id="web.login_layout"
              name="Analytix Login – Full Page" priority="25">

        <xpath expr="t[@t-call='web.frontend_layout']" position="replace">
            <t t-call="web.frontend_layout">
                <t t-set="html_data"      t-value="{'style': 'height:100%;'}"/>
                <t t-set="body_classname" t-value="'anlx_body'"/>
                <t t-set="no_header"      t-value="True"/>
                <t t-set="no_footer"      t-value="True"/>

                <style>
@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&amp;family=Inter:wght@400;500;600&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap');

*,*::before,*::after{box-sizing:border-box}

/* Hide Odoo "Skip to Content" link – all known variants */
a[href="#content"],
.o_skip_content,
a.skip_content,
.o_skip_to_content,
body > a:first-child,
body > .o_web_client > a:first-child{
  display:none!important;
  visibility:hidden!important;
  pointer-events:none!important;
  position:absolute!important;
  left:-9999px!important;
}

html,body,.anlx_body{
  margin:0!important;padding:0!important;
  background:#faf9f6!important;
  color:#171a1c!important;
  font-family:'Inter',sans-serif!important;
  min-height:100vh!important;
  overflow-x:hidden!important;
}



/* ── Stage ───────────────────────────────────────────────── */
.anlx_stage{
  min-height:100vh;
  display:flex;flex-direction:row;
  align-items:center;justify-content:center;
  gap:70px;padding:32px 6vw;position:relative;
}
.anlx_stage::before{
  content:'';position:absolute;inset:0;pointer-events:none;
  background:
    radial-gradient(700px 500px at 30% 30%,rgba(15,157,110,.06),transparent),
    radial-gradient(600px 500px at 80% 80%,rgba(193,125,16,.05),transparent);
}

/* ── Left ────────────────────────────────────────────────── */
.anlx_left{
  max-width:460px;width:100%;
  position:relative;z-index:1;
  display:flex;flex-direction:column;
  align-items:flex-start;text-align:left;
}
.anlx_hmark{width:64px;height:auto;display:block;margin-bottom:20px;object-fit:contain}
.anlx_eyebrow{
  display:inline-flex;align-items:center;gap:8px;
  font-family:'IBM Plex Mono',monospace;font-size:11.5px;
  letter-spacing:.14em;text-transform:uppercase;
  color:#6b7178;margin-bottom:22px;
}
.anlx_dot{
  width:6px;height:6px;border-radius:50%;
  background:#0f9d6e;display:inline-block;
  box-shadow:0 0 0 3px rgba(15,157,110,.15);
  animation:anlxPulse 2s ease-in-out infinite;
}
@keyframes anlxPulse{0%,100%{opacity:1}50%{opacity:.4}}

.anlx_h1{
  font-family:'Space Grotesk',sans-serif;
  font-weight:700;font-size:clamp(30px,3.4vw,42px);
  line-height:1.08;letter-spacing:-.02em;
  margin:0 0 14px;color:#171a1c;
}
.anlx_accent{color:#0f9d6e}

.anlx_lead{
  color:#6b7178;font-size:14.5px;line-height:1.6;
  max-width:420px;margin:0 0 28px;
}

/* Chart */
.anlx_cc{display:flex;flex-direction:column;align-items:flex-start;gap:12px;width:100%;max-width:400px}
.anlx_clr{display:flex;align-items:baseline;justify-content:space-between;width:100%}
.anlx_cl{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#9a9fa5}
.anlx_cv{font-family:'Space Grotesk',sans-serif;font-size:15px;font-weight:600;color:#0f9d6e}
.anlx_cpath{fill:none;stroke:#0f9d6e;stroke-width:2.2;stroke-linecap:round;stroke-dasharray:900;stroke-dashoffset:900;animation:anlxDraw 2.1s cubic-bezier(.4,0,.2,1) forwards .3s}
@keyframes anlxDraw{to{stroke-dashoffset:0}}
.anlx_cfill{opacity:0;animation:anlxFF 1.2s ease forwards 1.7s}
@keyframes anlxFF{to{opacity:1}}
.anlx_cn{opacity:0;animation:anlxPN .4s ease forwards}
@keyframes anlxPN{from{opacity:0;transform:scale(.3)}to{opacity:1;transform:scale(1)}}
.anlx_cne{opacity:0;animation:anlxPN .4s ease forwards,anlxGlow 1.8s ease-in-out infinite 2.4s}
@keyframes anlxGlow{0%,100%{filter:drop-shadow(0 0 0px rgba(15,157,110,0))}50%{filter:drop-shadow(0 0 6px rgba(15,157,110,.9))}}

/* ── Right card ──────────────────────────────────────────── */
.anlx_card{
  width:400px;flex-shrink:0;
  background:#ffffff;border:1px solid #e4e2db;
  border-radius:14px;padding:34px 32px 26px;
  position:relative;z-index:1;
  box-shadow:0 20px 50px -18px rgba(23,26,28,.14);
}
.anlx_brow{display:flex;align-items:center;gap:10px;margin-bottom:4px}
.anlx_bmark{width:32px;height:auto;flex-shrink:0}
.anlx_bname{
  font-family:'Space Grotesk',sans-serif;
  font-size:21px;font-weight:700;
  letter-spacing:.01em;margin:0;color:#163456;
}
.anlx_bx{color:#e0453b}
.anlx_sub{color:#6b7178;font-size:13.5px;margin-bottom:28px;font-family:'Inter',sans-serif}
.anlx_sub b{color:#0f9d6e;font-weight:500}

/* Strip Odoo card chrome */
.anlx_fw .card,.anlx_fw .card-body{border:none!important;background:transparent!important;box-shadow:none!important;padding:0!important;margin:0!important}
.anlx_fw .card-title,.anlx_fw .text-center.pb-3.border-bottom{display:none!important}

/* Labels */
.anlx_fw label.form-label,.anlx_fw label.col-form-label{
  font-family:'IBM Plex Mono',monospace!important;
  font-size:10.5px!important;letter-spacing:.1em!important;
  text-transform:uppercase!important;color:#9a9fa5!important;
  margin-bottom:8px!important;display:block!important;
}

/* Inputs */
.anlx_fw .form-control{
  width:100%!important;background:#f6f5f1!important;
  border:1px solid #e4e2db!important;border-radius:8px!important;
  padding:12px 14px!important;color:#171a1c!important;
  font-size:14px!important;font-family:'Inter',sans-serif!important;
  outline:none!important;box-shadow:none!important;
  transition:border-color .15s ease,box-shadow .15s ease!important;
}
.anlx_fw .form-control::placeholder{color:#9a9fa5!important}
.anlx_fw .form-control:focus{
  border-color:#bfe9d9!important;
  box-shadow:0 0 0 3px rgba(15,157,110,.14)!important;
}

/* Password group */
.anlx_fw .input-group{border-radius:8px!important;overflow:hidden!important}
.anlx_fw .input-group .form-control{border-right:none!important;border-radius:8px 0 0 8px!important}
.anlx_fw .input-group .o_show_password,.anlx_fw .input-group .btn{
  border:1px solid #e4e2db!important;border-left:none!important;
  border-radius:0 8px 8px 0!important;background:#f6f5f1!important;
  color:#6b7178!important;padding:0 13px!important;
}
.anlx_fw .input-group:focus-within .form-control,
.anlx_fw .input-group:focus-within .o_show_password,
.anlx_fw .input-group:focus-within .btn{border-color:#bfe9d9!important}

/* Remember/Forgot */
.anlx_fw .d-flex.justify-content-between{
  display:flex!important;align-items:center!important;
  justify-content:space-between!important;margin:12px 0!important;
}
.anlx_fw .form-check-label{font-size:13px!important;color:#374151!important}

/* Links */
.anlx_fw a,.anlx_fw a.btn-link{
  color:#0f9d6e!important;font-size:12px!important;
  font-weight:500!important;text-decoration:none!important;
}
.anlx_fw a:hover{text-decoration:underline!important}

/* Submit button */
.anlx_fw button[type="submit"],.anlx_fw button.btn-primary,
.anlx_fw .oe_login_buttons button.btn-primary{
  width:100%!important;margin-top:8px!important;
  background:#0f9d6e!important;color:#06140f!important;
  border:none!important;border-radius:8px!important;
  padding:13px 16px!important;font-size:14.5px!important;
  font-weight:600!important;font-family:'Inter',sans-serif!important;
  cursor:pointer!important;letter-spacing:.3px!important;
  transition:transform .12s ease,box-shadow .15s ease,background .15s ease!important;
}
.anlx_fw button[type="submit"]:hover,.anlx_fw button.btn-primary:hover{
  background:#3fe3a6!important;
  box-shadow:0 8px 20px -6px rgba(15,157,110,.45)!important;
}
.anlx_fw button[type="submit"]:active{transform:scale(.98)!important}

/* Alerts */
.anlx_fw .alert{border-radius:8px!important;font-size:13px!important;padding:10px 14px!important;margin-bottom:14px!important}

/* Hide Odoo chrome */
.anlx_fw input[name="db"],.anlx_fw select[name="db"]{display:none!important}
.anlx_fw .mb-3:has(input[name="db"]),.anlx_fw .mb-3:has(select[name="db"]),.anlx_fw .mb-3:has(label[for="db"]){display:none!important}
.anlx_fw .text-center.small.mt-4{display:none!important}
.o_caps_lock_warning_text{display:none!important}
.o_login_auth,.o_login_auth em,.o_login_separator{display:none!important}
button.o_user_switch_btn,.o_user_switch_btn,.o_user_switch{display:none!important}
input#login,input[name="login"]{border-radius:8px!important;width:100%!important}

/* Divider + footer */
.anlx_div{border:none!important;border-top:1px solid #e4e2db!important;margin:24px 0 16px!important}
.anlx_foot{font-size:11.5px!important;color:#9a9fa5!important;text-align:center!important;font-family:'Inter',sans-serif!important}

/* Responsive */
@media(max-width:880px){
  .anlx_stage{flex-direction:column!important;gap:36px!important;padding:40px 24px 60px!important}
  .anlx_left{max-width:100%!important}
  .anlx_card{width:100%!important;max-width:400px!important}
}
                </style>

                <script>
(function(){
  try{localStorage.removeItem('web.last_connected_users')}catch(e){}

  function clean(){
    var f=document.querySelector('.anlx_fw');
    if(!f)return;
    // DB row
    var db=f.querySelector('input[name="db"],select[name="db"]');
    if(db){var r=db.closest('.mb-3')||db.closest('.form-group')||db.parentElement;if(r)r.style.cssText+=';display:none!important'}
    f.querySelectorAll('label[for="db"]').forEach(function(l){var r=l.closest('.mb-3')||l.closest('.form-group')||l.parentElement;if(r)r.style.cssText+=';display:none!important'});
    // Signup/passkey links
    f.querySelectorAll('a[href]').forEach(function(a){
      if(a.href.includes('/web/signup')||a.href.includes('/odoo/signup')||a.href.includes('passkey')||a.textContent.toLowerCase().includes('passkey'))
        a.style.cssText+=';display:none!important';
    });
    // Separators / user switch
    f.querySelectorAll('.o_login_separator').forEach(function(e){e.style.cssText+=';display:none!important'});
    document.querySelectorAll('.o_user_switch_btn,.o_user_switch').forEach(function(e){e.style.cssText+=';display:none!important'});
    document.querySelectorAll('button').forEach(function(b){if(b.textContent.trim().toLowerCase().includes('choose a user'))b.style.cssText+=';display:none!important'});
    // Email full-width
    var lg=document.querySelector('input#login,input[name="login"]');
    if(lg){var ig=lg.closest('.input-group');if(ig){ig.style.cssText+=';display:block!important';ig.classList.remove('input-group')}lg.style.cssText+=';border-radius:8px!important;width:100%!important'}
  }

  /* Remove "Skip to Content" link by text */
  function removeSkip(){
    document.querySelectorAll('a').forEach(function(a){
      var t=a.textContent.trim().toLowerCase();
      if(t==='skip to content'||t==='skip to main content'||a.href.endsWith('#content')){
        a.style.cssText='display:none!important;visibility:hidden!important;position:absolute!important;left:-9999px!important';
        if(a.parentElement &amp;&amp; a.parentElement.children.length===1) a.parentElement.style.display='none';
      }
    });
  }

  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',function(){clean();removeSkip();});
  else{clean();removeSkip();}
  setTimeout(function(){clean();removeSkip();},400);
  setTimeout(function(){clean();removeSkip();},1000);


})();
                </script>

                <!-- Stage -->
                <div class="anlx_stage">

                    <!-- LEFT: Hero -->
                    <div class="anlx_left">
                        <img class="anlx_hmark" src="/new_login_form/static/src/img/logo.png" alt="Company Logo"/>

                        <div class="anlx_eyebrow">
                            <span class="anlx_dot"></span>
                            LIVE SESSION · ENCRYPTED CHANNEL
                        </div>

                        <h1 class="anlx_h1">
                            Every metric<br/>
                            moves. Stay<br/>
                            <span class="anlx_accent">ahead of it.</span>
                        </h1>

                        <p class="anlx_lead">
                            Analytix keeps your operations, inventory, and revenue on one screen — synced in real time, so nothing surprises you at month end.
                        </p>

                        <!-- Chart card -->
                        <div class="anlx_cc">
                            <div class="anlx_clr">
                                <span class="anlx_cl">Revenue · trailing 6mo</span>
                                <span class="anlx_cv">▲ 214%</span>
                            </div>
                            <svg viewBox="0 0 440 150" style="display:block;overflow:visible;width:100%;height:auto;max-width:400px;">
                                <defs>
                                    <linearGradient id="anlxFG" x1="0" y1="0" x2="0" y2="1">
                                        <stop offset="0%"   stop-color="#0f9d6e" stop-opacity="0.16"/>
                                        <stop offset="100%" stop-color="#0f9d6e" stop-opacity="0"/>
                                    </linearGradient>
                                </defs>
                                <path class="anlx_cfill"
                                    d="M0,120 C40,124 70,110 100,100 C140,88 160,60 200,50 C240,40 260,60 300,44 C340,28 370,18 440,10 L440,150 L0,150 Z"
                                    fill="url(#anlxFG)"/>
                                <path class="anlx_cpath"
                                    d="M0,120 C40,124 70,110 100,100 C140,88 160,60 200,50 C240,40 260,60 300,44 C340,28 370,18 440,10"/>
                                <circle class="anlx_cn" style="animation-delay:.5s"  cx="100" cy="100" r="4" fill="#faf9f6" stroke="#0f9d6e" stroke-width="2"/>
                                <circle class="anlx_cn" style="animation-delay:1.1s" cx="200" cy="50"  r="4" fill="#faf9f6" stroke="#0f9d6e" stroke-width="2"/>
                                <circle class="anlx_cn" style="animation-delay:1.6s" cx="300" cy="44"  r="4" fill="#faf9f6" stroke="#0f9d6e" stroke-width="2"/>
                                <circle class="anlx_cne" style="animation-delay:2.1s" cx="440" cy="10" r="5.5" fill="#0f9d6e"/>
                            </svg>
                        </div>
                    </div>

                    <!-- RIGHT: Login card -->
                    <div class="anlx_card">
                        <div class="anlx_brow">
                            <img class="anlx_bmark" src="/new_login_form/static/src/img/logo.png" alt="Company Logo"/>
                            <p class="anlx_bname">ANALYT<span>I</span><span class="anlx_bx">X</span></p>
                        </div>

                        <p class="anlx_sub"><b>Welcome back</b> — sign in to your workspace</p>

                        <div class="anlx_fw">
                            <t t-out="0"/>
                        </div>

                        <hr class="anlx_div"/>
                        <p class="anlx_foot">© 2026 Analytix, Inc. All rights reserved.</p>
                    </div>

                </div><!-- /stage -->

            </t>
        </xpath>
    </template>

</odoo>
