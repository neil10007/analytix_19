<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_pos_customisation" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.pos.customisation</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_bills_and_receipts_section']" position="inside">
                    <setting id="hide_receipt_header_qr_setting"
                             string="Hide Header QR Code"
                             help="Hide the QR code displayed right below the company logo on POS receipts.">
                        <field name="hide_receipt_header_qr"/>
                    </setting>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
