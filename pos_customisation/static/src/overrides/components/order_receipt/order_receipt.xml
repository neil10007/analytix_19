<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_customisation.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <div class="custom-saudi-receipt" t-if="order">

                <!-- 1. HEADER WITH COMPANY LOGO -->
                <div class="r-header text-center">
                    <img t-if="order.companyLogoUrl"
                         t-att-src="order.companyLogoUrl"
                         alt="Logo"
                         class="r-logo mx-auto d-block mb-1"/>

                    <div class="r-company-en" t-out="order.company?.name || ''"/>

                    <div t-if="order.config?.receipt_header"
                         class="r-company-ar"
                         style="white-space:pre-line"
                         dir="rtl"
                         t-out="order.config.receipt_header"/>

                    <div class="r-address">
                        <div t-if="order.company?.street" t-out="order.company.street"/>
                        <div t-if="order.company?.city or order.company?.country_id">
                            <t t-if="order.company?.city" t-out="order.company.city"/>
                            <t t-if="order.company?.country_id">, <t t-out="order.company.country_id.code || ''"/></t>
                        </div>
                        <div t-if="order.company?.vat">Vat: <t t-out="order.company.vat"/></div>
                    </div>

                    <div class="r-title-ar" dir="rtl">فاتورة ضريبية مبسطة</div>
                    <div class="r-title-en">Simplified Tax Invoice</div>
                </div>

                <!-- 2. INVOICE DETAILS TABLE -->
                <table class="r-details-table">
                    <tr class="r-details-row">
                        <td class="r-details-en">Invoice Number:</td>
                        <td class="r-details-val" t-esc="order.orderNumber"/>
                        <td class="r-details-ar" dir="rtl">رقم الفاتورة</td>
                    </tr>
                    <tr class="r-details-row">
                        <td class="r-details-en">Invoice Issue Date</td>
                        <td class="r-details-val" t-esc="order.orderIssueDate"/>
                        <td class="r-details-ar" dir="rtl">تاريخ اصدار الفاتورة</td>
                    </tr>
                    <tr class="r-details-row">
                        <td class="r-details-en">Date of Supply:</td>
                        <td class="r-details-val" t-esc="order.dateOfSupply"/>
                        <td class="r-details-ar" dir="rtl">تاريخ التوريد</td>
                    </tr>
                </table>

                <!-- 3. PRODUCT TABLE (WITH SERIAL NUMBER BEFORE ITEM NAME) -->
                <table class="r-items-table">
                    <thead>
                        <tr class="r-items-head">
                            <th class="r-col-sno">#</th>
                            <th class="r-col-name">
                                <div>Item Name</div>
                                <div dir="rtl">تفاصيل السلع أو الخدمة</div>
                            </th>
                            <th class="r-col-price">
                                <div>Unit price</div>
                                <div dir="rtl">سعر الوحدة</div>
                            </th>
                            <th class="r-col-qty">
                                <div>Quantity</div>
                                <div dir="rtl">الكمية</div>
                            </th>
                            <th class="r-col-total">
                                <div>Item Subtotal</div>
                                <div>(Inc. VAT)</div>
                                <div dir="rtl">المجموع شامل الضريبة</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="order.lines || []" t-as="line" t-key="line.uuid || line_index">
                            <tr class="r-item-row">
                                <td class="r-col-sno"><t t-esc="line_index + 1"/></td>
                                <td class="r-col-name">
                                    <div class="r-item-name"
                                         t-esc="line.productDisplayName || line.full_product_name || (line.product_id ? line.product_id.display_name : '')"/>
                                    <!-- NEW: Arabic name -->
                                    <div t-if="line.productArabicName"
                                         class="r-item-name-ar"
                                         dir="rtl"
                                         t-esc="line.productArabicName"/>
                                    <div t-if="line.serialNumber" class="r-sn">SN: <t t-esc="line.serialNumber"/></div>
                                </td>
                                <td class="r-col-price"><t t-esc="line.unitPriceExclFormatted"/></td>
                                <td class="r-col-qty"><t t-esc="line.quantityFormatted"/></td>
                                <td class="r-col-total"><t t-esc="line.subtotalInclFormatted"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>

                <!-- 4. TOTALS TABLE (3 COLUMNS: ENGLISH, ARABIC, VALUE) -->
                <table class="r-totals-table">
                    <tr>
                        <td class="r-total-en">Total Taxable Amount (Excluding VAT)</td>
                        <td class="r-total-ar" dir="rtl">الإجمالي الخاضع للضريبة (غير شاملة ضريبة القيمة المضافة)</td>
                        <td class="r-total-val"><span class="r-sar-symbol">&#65020;</span>&#160;<t
                                t-esc="order.totalTaxableAmountExcl"/></td>
                    </tr>
                    <tr>
                        <td class="r-total-en">Discount</td>
                        <td class="r-total-ar" dir="rtl">مجموع الخصومات</td>
                        <td class="r-total-val"><span class="r-sar-symbol">&#65020;</span>&#160;<t
                                t-esc="order.totalDiscountAmount"/></td>
                    </tr>

                    <t t-if="order.taxDetails and order.taxDetails.length > 0">
                        <t t-foreach="order.taxDetails" t-as="tax" t-key="tax.id">
                            <tr>
                                <td class="r-total-en"><t t-esc="tax.name.toLowerCase().includes('vat') ? tax.name : ('Total VAT ' + tax.name)"/></td>
                                <td class="r-total-ar" dir="rtl">مجموع ضريبة القيمة المضافة 15%</td>
                                <td class="r-total-val"><span class="r-sar-symbol">&#65020;</span>&#160;<t
                                        t-esc="tax.amountFormatted"/></td>
                            </tr>
                        </t>
                    </t>
                    <t t-else="">
                        <tr>
                            <td class="r-total-en">Total VAT 15%</td>
                            <td class="r-total-ar" dir="rtl">مجموع ضريبة القيمة المضافة 15%</td>
                            <td class="r-total-val"><span class="r-sar-symbol">&#65020;</span>&#160;<t
                                    t-esc="order.totalVatAmount"/></td>
                        </tr>
                    </t>

                    <tr class="r-grand-total">
                        <td class="r-total-en">Total Amount Due</td>
                        <td class="r-total-ar" dir="rtl">إجمالي المبلغ المستحق</td>
                        <td class="r-total-val"><span class="r-sar-symbol">&#65020;</span>&#160;<t
                                t-esc="order.totalAmountDue"/></td>
                    </tr>
                </table>

                <!-- 5. AMOUNT IN WORDS -->
                <div class="r-amount-words">
                    <t t-esc="order.amountInWordsSAR"/>
                </div>

                <!-- 6. ITEMS COUNT -->
                <div class="r-items-count">
                    Items : <t t-esc="order.totalItemsCount"/>
                </div>

                <!-- 7. PAYMENT SECTION -->
                <div class="r-payment-section">
                    <t t-if="paymentLines and paymentLines.length > 0">
                        <t t-foreach="paymentLines" t-as="pline" t-key="pline.uuid || pline_index">
                            <div class="r-payment-row">
                                <span class="r-pay-method" t-esc="pline.payment_method_id?.name || 'Cash'"/>
                                <span class="r-pay-amount" t-esc="pline.amountFormatted"/>
                                <span class="r-pay-status" t-esc="pline.statusDisplayName || (pline.isCustomerAccount ? 'Status : Amount Due' : ((pline.payment_method_id?.type === 'pay_later' || (pline.payment_method_id?.name and (pline.payment_method_id.name.toLowerCase().includes('customer') || pline.payment_method_id.name.includes('حساب')))) ? 'Status : Amount Due' : 'Status : Paid'))"/>
                            </div>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="r-payment-row">
                            <span class="r-pay-method">Cash</span>
                            <span class="r-pay-amount" t-esc="order.totalAmountDue"/>
                            <span class="r-pay-status">Status : Paid</span>
                        </div>
                    </t>
                    <div class="r-payment-row">
                        <span class="r-pay-method">Balance</span>
                        <span class="r-pay-amount" t-esc="order.balanceAmount"/>
                        <span class="r-pay-status"></span>
                    </div>
                </div>

                <!-- 8. QR CODE -->
                <div class="r-qr text-center">
                    <img t-if="order.saQrCode"
                         id="zatca_bottom_qrcode"
                         t-att-src="order.saQrCode"
                         class="mx-auto d-block"/>
                </div>

                <!-- 9. FOOTER -->
                <div class="r-footer">
                    <div class="r-footer-row">
                        <span class="r-cashier"><t t-esc="order.cashierDisplayName"/>
                            -
                            <t t-esc="order.orderNumber"/></span>
                        <span class="r-print-date">Print Date : <t t-esc="order.orderPrintDate"/></span>
                    </div>
                    <div class="r-barcode">
                        *<t t-esc="order.orderBarcodeRaw"/>*
                    </div>
                    <div class="r-thank-you">
                        <div>Thank you</div>
                        <div>Visit Again</div>
                    </div>
                </div>

            </div>
        </xpath>
    </t>
</templates>
